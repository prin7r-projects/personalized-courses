# Public app URL used in NOWPayments redirects + IPN callback URLs.
NEXT_PUBLIC_APP_URL=https://personalized-courses.prin7r.com
NEXT_PUBLIC_SITE_URL=https://personalized-courses.prin7r.com

# NOWPayments hosted invoice + IPN.
# Keys live only in the deploy host's /opt/prin7r-deploys/personalized-courses/.env
# Reference values are documented in /Users/keer/.nth-kir-keys.env (private).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# (Forward-compat; not used by Wave 2 landing) WalletConnect / Reown project.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# (Forward-compat; not used by Wave 2 landing) Plisio direct stablecoin.
PLISIO_API_KEY=

# (Forward-compat; not used by Wave 2 landing) Merchant settlement wallets.
MERCHANT_USDT_TRC20_ADDRESS=
MERCHANT_USDT_ERC20_ADDRESS=
MERCHANT_USDC_ERC20_ADDRESS=
MERCHANT_USDC_POLYGON_ADDRESS=
MERCHANT_USDT_BSC_ADDRESS=

# ── Wave 3 app vars ───────────────────────────────────────────────────
# Database (uses docker-compose service name "postgres")
DATABASE_URL=postgresql://curriculum7:${POSTGRES_PASSWORD:-curriculum7}@postgres:5432/curriculum7
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=https://personalized-courses.prin7r.com/app
AUTH_TRUST_HOST=true
POSTMARK_SERVER_TOKEN=your-postmark-server-token
ANTHROPIC_API_KEY=your-anthropic-api-key
GITHUB_TOKEN=optional-github-token-for-verifier
# Postgres password (must match docker-compose POSTGRES_PASSWORD)
POSTGRES_PASSWORD=curriculum7
