# Curriculum7 App — environment variables
# Copy to .env and fill in values.

# Database (Postgres 16)
DATABASE_URL=postgresql://user:password@host:5432/curriculum7

# Auth (NextAuth v5)
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3100

# Postmark (transactional email)
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Anthropic (Claude 4.7 — syllabus + grading)
ANTHROPIC_API_KEY=your-anthropic-api-key

# GLM 5.1 fallback (Z.AI)
GLM_API_KEY=your-glm-api-key

# Backblaze B2 (submission storage)
B2_KEY_ID=your-b2-key-id
B2_APP_KEY=your-b2-app-key
B2_BUCKET=prin7r-rl-submissions

# NOWPayments (shared with landing via compose env_file)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
